class DatePickerWidget(ctk.CTkFrame):
    """
    A small button that opens a calendar popup.
    .get() returns '' or 'YYYY-MM-DD'.
    .set(date_str) accepts 'YYYY-MM-DD' or '' to clear.
    """
    def __init__(self, master, **kwargs):
        super().__init__(master, fg_color="transparent")
        self._date_str = ""

        if CALENDAR_AVAILABLE:
            self._label = ctk.CTkButton(
                self, text="📅  Select date", width=140,
                fg_color="#1e272e", text_color="white",
                border_color="#3498db", border_width=1,
                command=self._open_calendar
            )
            self._label.pack()
        else:
            # Fallback plain entry
            self._entry = ctk.CTkEntry(self, width=140, placeholder_text="YYYY-MM-DD",
                                       fg_color="#1e272e", text_color="white",
                                       placeholder_text_color="gray")
            self._entry.pack()

    def _open_calendar(self):
        top = tk.Toplevel(self)
        top.title("Pick a date")
        top.resizable(False, False)
        top.grab_set()

        from tkcalendar import Calendar
        cal = Calendar(top, selectmode="day", date_pattern="yyyy-mm-dd",
                       background="#1e272e", foreground="white",
                       headersbackground="#2980b9", headersforeground="white",
                       selectbackground="#27ae60", normalbackground="#2f3542",
                       normalforeground="white", weekendforeground="#74b9ff",
                       othermonthforeground="gray", bordercolor="#34495e")
        if self._date_str:
            try:
                cal.selection_set(self._date_str)
            except Exception:
                pass
        cal.pack(padx=10, pady=10)

        def _pick():
            self._date_str = cal.get_date()   # already 'YYYY-MM-DD' due to pattern
            self._label.configure(text=f"📅  {self._date_str}")
            top.destroy()

        def _clear():
            self._date_str = ""
            self._label.configure(text="📅  Select date")
            top.destroy()

        btn_row = tk.Frame(top, bg="#1e272e")
        btn_row.pack(pady=(0, 10))
        tk.Button(btn_row, text="OK", bg="#27ae60", fg="white", width=8, command=_pick).pack(side="left", padx=5)
        tk.Button(btn_row, text="Clear", bg="#c0392b", fg="white", width=8, command=_clear).pack(side="left", padx=5)

    def get(self):
        if CALENDAR_AVAILABLE:
            return self._date_str
        else:
            return self._entry.get().strip()

    def set(self, date_str):
        self._date_str = date_str
        if CALENDAR_AVAILABLE:
            if date_str:
                self._label.configure(text=f"📅  {date_str}")
            else:
                self._label.configure(text="📅  Select date")
        else:
            self._entry.delete(0, "end")
            if date_str:
                self._entry.insert(0, date_str)


