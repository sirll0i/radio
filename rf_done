        def search_user():
            u = self.entries['username'].get()
            if not u: messagebox.showerror("Error","Enter a username!"); return
            conn = connect_db(); cursor = conn.cursor()
            cursor.execute("SELECT username,password,name,email,usertype FROM user WHERE username=%s",(u,))
            res = cursor.fetchone(); conn.close()
            if res:
