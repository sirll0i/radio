    def toggle_mode(self, mode):
        self.is_auto = (mode == "AUTO")
        self.f_knob.configure(state="disabled" if self.is_auto else "normal")
        if self.is_auto:
            self.save_as_auto = False
            self.target_f = random.randint(50, 1000); self.target_p = random.randint(-50, 10)
            self.run_auto_scan()

    def run_auto_scan(self):
        if not self.is_auto: return
        current_f = self.f_knob.get(); current_p = self.p_knob.get()
        dist_f = self.target_f - current_f; dist_p = self.target_p - current_p
        if abs(dist_f) < 15 and abs(dist_p) < 3:
            self.f_knob.set(self.target_f); self.p_knob.set(self.target_p)
            self.freq_val = self.target_f; self.power_val = self.target_p
            self.update_radio_logic(is_init=True); self.force_auto_save()
            self.is_auto = False; self.mode_switch.set("MANUAL"); self.f_knob.configure(state="normal"); return
        step_f = 15 if dist_f > 0 else -15; step_p = 2 if dist_p > 0 else -2
        self.f_knob.set(current_f + step_f); self.p_knob.set(current_p + step_p)
        self.freq_val = int(current_f + step_f); self.power_val = int(current_p + step_p)
        self.update_radio_logic(is_init=True); self.after(50, self.run_auto_scan)

    def force_auto_save(self):
        conn = connect_db()
        if conn:
            try:
                cursor = conn.cursor()
                cursor.execute("INSERT INTO frequency_logs (username, frequency, power_level, mode) VALUES (%s,%s,%s,%s)",
                               (self.logged_user_name, self.freq_val, self.power_val, "AUTOMATIC"))
                conn.commit()
                self.last_saved_freq = self.freq_val; self.last_saved_power = self.power_val
                self.log_activity(f"Used Radio (AUTOMATIC): Adjusted Frequency to {self.freq_val} MHz")
            except Exception as e: print(f"Auto-save error: {e}")
            finally: conn.close()

    def update_freq(self, val):
        self.freq_val = int(float(val)); self.update_radio_logic()

    def update_power(self, val):
        self.power_val = int(float(val)); self.update_radio_logic()

    def save_frequency_log(self):
        if self.freq_val == self.last_saved_freq and self.power_val == self.last_saved_power: return
        conn = connect_db()
        if conn:
            try:
                cursor = conn.cursor()
                cursor.execute("INSERT INTO frequency_logs (username, frequency, power_level, mode) VALUES (%s,%s,%s,%s)",
                               (self.logged_user_name, self.freq_val, self.power_val, "MANUAL"))
                conn.commit()
                self.last_saved_freq = self.freq_val; self.last_saved_power = self.power_val
                self.log_activity(f"Used Radio (MANUAL): Adjusted Frequency to {self.freq_val} MHz")
            except Exception as e: print(e)
            finally: conn.close()

    def update_radio_logic(self, is_init=False):
        self.freq_display.configure(text=f"{self.freq_val} MHz")
        frequency = max(1, self.freq_val); amplitude = (self.power_val + 60) / 60
        duration = 0.002
        t = np.linspace(0, duration, len(self.x_vals), endpoint=False)
        y = amplitude * np.sin(2 * np.pi * frequency * t)
        self.line.set_xdata(t); self.line.set_ydata(y)
        self.ax.set_xlim(0, duration); self.ax.set_ylim(-1.2, 1.2)
        self.canvas_plot.draw()
        for i in range(3): self.canvases[i].itemconfig(self.circles[i], fill="grey")
        if self.freq_val < 350:
            self.canvases[0].itemconfig(self.circles[0], fill="red")
            if not self.is_muted: winsound.Beep(1000, 100)
        elif self.freq_val <= 700:
            self.canvases[1].itemconfig(self.circles[1], fill="yellow")
        else:
            self.canvases[2].itemconfig(self.circles[2], fill="green")
        if not is_init:
            if self.save_timer: self.after_cancel(self.save_timer)
            self.save_timer = self.after(3000, self.save_frequency_log)

