    def print_report_to_pdf(self):
        headers = getattr(self, '_last_report_headers', [])
        data    = getattr(self, '_last_report_data', [])

        if not headers or not data:
            messagebox.showinfo("Print","No data to print. Apply a filter or wait for the table to load.")
            return

        # Build filter summary string
        parts = []
        date_from = self.date_from_picker.get()
        date_to   = self.date_to_picker.get()
        range_sel = self.range_var.get()
        chosen_name = self.user_filter_var.get()
        if date_from: parts.append(f"From: {date_from}")
        if date_to:   parts.append(f"To: {date_to}")
        if range_sel != "All" and self.report_type.get() == "Frequency History":
            parts.append(f"Range: {range_sel}")
        if chosen_name != "All" and self.report_type.get() == "System Logs":
            parts.append(f"User: {chosen_name}")
        filter_info = "  |  ".join(parts) if parts else "None"

        path = generate_and_print_pdf(
            title_text  = self.report_type.get(),
            headers     = headers,
            data        = data,
            filter_info = filter_info
        )
        if path:
            messagebox.showinfo("Print Sent",
                                f"PDF sent to printer.\n\nFile saved at:\n{path}\n\n"
                                "If a print dialog did not open automatically, "
                                "please open the file and press Ctrl+P.")

