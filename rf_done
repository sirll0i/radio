def generate_and_print_pdf(title_text, headers, data, filter_info=""):
    """
    Builds a landscape A4 PDF from headers+data and sends it to the default printer.
    Returns the temp file path on success, or None on failure.
    """
    if not REPORTLAB_AVAILABLE:
        messagebox.showerror("Missing Library",
                             "reportlab is not installed.\n"
                             "Run:  pip install reportlab")
        return None

    tmp_path = os.path.join(tempfile.gettempdir(), f"rf_report_{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}.pdf")

    doc = SimpleDocTemplate(
        tmp_path,
        pagesize=landscape(A4),
        leftMargin=1.5*cm, rightMargin=1.5*cm,
        topMargin=2*cm,    bottomMargin=2*cm
    )

    styles = getSampleStyleSheet()
    story  = []

    # ── Title block ──────────────────────────────────────────────────────────
    title_style = ParagraphStyle("RFTitle", parent=styles["Title"],
                                 fontSize=18, spaceAfter=4,
                                 textColor=colors.HexColor("#2c3e50"))
    story.append(Paragraph("RF Simulator — " + title_text, title_style))

    meta_style = ParagraphStyle("RFMeta", parent=styles["Normal"],
                                fontSize=9, textColor=colors.grey, spaceAfter=2)
    story.append(Paragraph(f"Generated: {datetime.datetime.now().strftime('%B %d, %Y  %H:%M:%S')}", meta_style))
    if filter_info:
        story.append(Paragraph(f"Filters applied: {filter_info}", meta_style))
    story.append(Spacer(1, 0.4*cm))

    # ── Table ────────────────────────────────────────────────────────────────
    table_data = [list(headers)]
    for row in data:
        table_data.append([str(v) for v in row])

    page_w = landscape(A4)[0] - 3*cm
    col_w  = page_w / len(headers)

    tbl = Table(table_data, colWidths=[col_w] * len(headers), repeatRows=1)
    tbl.setStyle(TableStyle([
        # Header
        ("BACKGROUND",    (0, 0), (-1, 0),  colors.HexColor("#2c3e50")),
        ("TEXTCOLOR",     (0, 0), (-1, 0),  colors.white),
        ("FONTNAME",      (0, 0), (-1, 0),  "Helvetica-Bold"),
        ("FONTSIZE",      (0, 0), (-1, 0),  9),
        ("ALIGN",         (0, 0), (-1, 0),  "CENTER"),
        ("BOTTOMPADDING", (0, 0), (-1, 0),  8),
        ("TOPPADDING",    (0, 0), (-1, 0),  8),
        # Rows
        ("FONTSIZE",      (0, 1), (-1, -1), 8),
        ("ALIGN",         (0, 1), (-1, -1), "CENTER"),
        ("VALIGN",        (0, 0), (-1, -1), "MIDDLE"),
        ("ROWBACKGROUNDS",(0, 1), (-1, -1), [colors.white, colors.HexColor("#ecf0f1")]),
        ("GRID",          (0, 0), (-1, -1), 0.4, colors.HexColor("#bdc3c7")),
        ("TOPPADDING",    (0, 1), (-1, -1), 5),
        ("BOTTOMPADDING", (0, 1), (-1, -1), 5),
    ]))
    story.append(tbl)

    # ── Footer count ─────────────────────────────────────────────────────────
    story.append(Spacer(1, 0.3*cm))
    story.append(Paragraph(f"Total records: {len(data)}", meta_style))

    try:
        doc.build(story)
    except Exception as e:
        messagebox.showerror("PDF Error", f"Could not build PDF:\n{e}")
        return None

    # ── Send to printer ───────────────────────────────────────────────────────
    try:
        # Windows: ShellExecute "print" verb
        import subprocess
        subprocess.Popen(
            ["cmd", "/c", "start", "/min", "", tmp_path],
            shell=False
        )
        # Use os.startfile with "print" verb for direct printing
        os.startfile(tmp_path, "print")
    except Exception:
        # Fallback: just open the PDF so the user can Ctrl+P
        try:
            os.startfile(tmp_path)
        except Exception as e2:
            messagebox.showerror("Print Error", f"Could not open PDF:\n{e2}")
            return None

    return tmp_path


