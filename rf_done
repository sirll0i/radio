        if not conn: return names
        try:
            cursor = conn.cursor()
            cursor.execute("SELECT name FROM user ORDER BY name ASC")
            for row in cursor.fetchall():
                if row[0]: names.append(row[0])
        except: pass
        finally: conn.close()
        return names

    def _get_username_for_name(self, display_name):
        """Given a full name, return the username (used in logs). Returns None if 'All'."""
        if display_name == "All": return None
        conn = connect_db()
        try:
            cursor = conn.cursor()
            cursor.execute("SELECT username FROM user WHERE name=%s LIMIT 1", (display_name,))
            res = cursor.fetchone()
            return res[0] if res else None
        except: return None
        finally:
            if conn: conn.close()

