    def update_status(self):
        now = datetime.datetime.now().strftime("%I:%M %p")
        role_tag = " [Admin]" if self.logged_user_type == "admin" else ""
        self.status_label.configure(text=f"User: {self.logged_user_name}{role_tag}\n{now}")
        self.after(1000, self.update_status)


