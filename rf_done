    def _build_freq_query(self):
        date_from = self.date_from_picker.get()
        date_to   = self.date_to_picker.get()
        range_sel = self.range_var.get()
        conditions = []; params = []
        if date_from: conditions.append("DATE(timestamp) >= %s"); params.append(date_from)
        if date_to:   conditions.append("DATE(timestamp) <= %s"); params.append(date_to)
        if range_sel == "Low":    conditions.append("frequency < 350")
        elif range_sel == "Medium": conditions.append("frequency >= 350 AND frequency <= 700")
        elif range_sel == "High":   conditions.append("frequency > 700")
        where = ("WHERE " + " AND ".join(conditions)) if conditions else ""
        sql = f"""
            SELECT timestamp, frequency,
                CASE WHEN frequency < 350 THEN 'LOW'
                     WHEN frequency <= 700 THEN 'MEDIUM'
                     ELSE 'HIGH' END,
                mode, username
            FROM frequency_logs {where}
            ORDER BY timestamp DESC
        """
        return sql, params

    def _build_logs_query(self):
        date_from   = self.date_from_picker.get()
        date_to     = self.date_to_picker.get()
        chosen_name = self.user_filter_var.get()
        conditions = []; params = []
        if date_from: conditions.append("DATE(l.timestamp) >= %s"); params.append(date_from)
        if date_to:   conditions.append("DATE(l.timestamp) <= %s"); params.append(date_to)
        # Filter by username resolved from display name
        if chosen_name != "All":
            username = self._get_username_for_name(chosen_name)
            if username:
                conditions.append("l.username = %s"); params.append(username)
        where = ("WHERE " + " AND ".join(conditions)) if conditions else ""
        # Join with user table to display name instead of username
        sql = f"""
            SELECT COALESCE(u.name, l.username) AS display_name,
                   l.action, l.timestamp
            FROM system_logs l
            LEFT JOIN user u ON l.username = u.username
            {where}
            ORDER BY l.timestamp DESC
        """
        return sql, params

    def refresh_report_table(self, view_type):
        for w in self.report_container.winfo_children(): w.destroy()
        conn = connect_db()
        if not conn: return
        cursor = conn.cursor()
        try:
            if view_type == "Frequency History":
                headers = ["DATE AND TIME","FREQUENCY","RANGE","MODE","USER"]
                sql, params = self._build_freq_query()
            else:
                headers = ["NAME","ACTION","DATE AND TIME"]
                sql, params = self._build_logs_query()
            cursor.execute(sql, params)
            data = cursor.fetchall()
            self._last_report_headers = headers
            self._last_report_data    = data
        except Exception as e:
            print(f"Report error: {e}")
            data = []; self._last_report_headers = []; self._last_report_data = []
        finally: conn.close()

        col_count = len(headers)
        for col_idx in range(col_count):
            self.report_container.grid_columnconfigure(col_idx, weight=1)

        for col, text in enumerate(headers):
            hcell = ctk.CTkFrame(self.report_container, fg_color="#1e272e", corner_radius=0, border_width=1)
            hcell.grid(row=0, column=col, sticky="nsew")
            ctk.CTkLabel(hcell, text=text, font=("Arial",12,"bold"), text_color="white", width=160).pack(pady=10, padx=5)

        for row_idx, row_data in enumerate(data, start=1):
            for col_idx, value in enumerate(row_data):
                bg = "#3d4451" if row_idx % 2 == 0 else "#2f3542"
                cell = ctk.CTkFrame(self.report_container, fg_color=bg, corner_radius=0, border_width=1, border_color="#57606f")
                cell.grid(row=row_idx, column=col_idx, sticky="nsew")
                ctk.CTkLabel(cell, text=str(value), font=("Arial",11), text_color="white").pack(pady=8, padx=5)

